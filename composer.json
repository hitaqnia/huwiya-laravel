{
    "name": "hitaqnia/huwiya",
    "description": "A Laravel SDK for integrating with the Huwiya Identity Provider.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "huwiya",
        "identity",
        "oauth",
        "authentication",
        "jwt"
    ],
    "authors": [
        {
            "name": "HiTaqnia",
            "email": "info@hitaqnia.com"
        }
    ],
    "homepage": "https://github.com/hitaqnia/huwiya-laravel",
    "support": {
        "issues": "https://github.com/hitaqnia/huwiya-laravel/issues",
        "source": "https://github.com/hitaqnia/huwiya-laravel"
    },
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Huwiya\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Huwiya\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Huwiya\\HuwiyaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}